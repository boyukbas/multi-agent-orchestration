# Copy to .env and fill in to enable the real-LLM path (autonomous decomposition by Claude).
# Without this key the system still runs end-to-end using the offline ScriptedLLM.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown):
# ORCHESTRATOR_MODEL=claude-opus-4-8
# ORCHESTRATOR_MAX_REVIEW=2
